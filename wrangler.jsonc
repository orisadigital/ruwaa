{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in Cloudflare, and the self-reference binding
  // below must match this — a mismatch fails the deploy with code 10143.
  "name": "ruwaa",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ruwaa"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Workers Builds runs `npx wrangler deploy` with no build step, so build the
  // OpenNext bundle here.
  "build": {
    "command": "npx opennextjs-cloudflare build"
  },
  "observability": {
    "enabled": true
  }
}
